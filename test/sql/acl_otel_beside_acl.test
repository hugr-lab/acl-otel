# name: test/sql/acl_otel_beside_acl.test
# description: spec 001 - loaded beside acl (ACL_EXT names the base built extension): the base events reach the sink, and the level policy decides a session level when it opens
# group: [sql]

require-env ACL_EXT

statement ok
LOAD '{ACL_EXT}';

statement ok
LOAD '{BUILD_DIRECTORY}/extension/acl_otel/acl_otel.duckdb_extension';

query I
SELECT acl_otel_status() LIKE '%"acl_loaded":true%';
----
true

statement ok
ATTACH ':memory:' AS store;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SET GLOBAL acl_audit_level = 'denied';

statement ok
SELECT acl_define_issuer('https://issuer.test/s',
    '{"keys":[{"kty":"oct","k":"YWNsLXRlc3QtaHMyNTYtc2VjcmV0"}]}',
    'api://acl-test', 'HS256', 'roles', '{"tid": "tenant"}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select) MAIN;

# the rule: the analyst's sessions through the gateway door are recorded at `all`
statement ok
SET GLOBAL acl_otel_level_rules = '[{"role": "analyst", "level": "all"}]';

# an allowed statement on that session is recorded although the instance is at `denied`
statement ok
SELECT acl_session_open('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3MiLCJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwic3ViIjoidWEiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.pj_vV6OmT_k_3y1MWLBTC_SjngWPkzsFS5K0iULL6OM') AS h;

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) > 0 FROM acl_audit_events() WHERE kind = 'session' AND detail = 'opened' AND level = 'all';
----
true

# spec 004, the operator's half: the base's own listing says the level in force AND where it came
# from, and `policy` means OUR rule decided it - not the instance default, not an operator's
# override. This is the one assertion that makes the two halves agree in public: the extension sets
# a level through the contract, and the operator reads the answer from the base, in one place.
# (string matching, like the base's own acl_session.test: the listing is a JSON string and this file
# must not depend on the json extension being loadable in the runner)
query III
SELECT acl_sessions() LIKE '%"subject":"ua"%',
       acl_sessions() LIKE '%"level":"all"%',
       acl_sessions() LIKE '%"level_source":"policy"%';
----
true	true	true

# ...and the sink saw them: the extension counts what the base handed it
query I
SELECT acl_otel_status() LIKE '%"received":0%';
----
false

# spec 002: the transport's failure is visible - a port nobody listens on, the batch flushed, the
# status counts the events that did not arrive and carries the SDK's reason (R6.2, R6.3)
statement ok
SET GLOBAL acl_otel_timeout = 1;

statement ok
SET GLOBAL acl_otel_endpoint = 'http://127.0.0.1:1';

statement ok
SELECT acl_session_open('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3MiLCJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwic3ViIjoidWEiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.pj_vV6OmT_k_3y1MWLBTC_SjngWPkzsFS5K0iULL6OM') AS h;

statement ok
SELECT acl_audit_flush();

query I
SELECT acl_otel_flush();
----
true

# the sink's own numbers, not the scrape's: `queue_fill` is where the log side of the status starts
# (spec 003 put a `metrics` object with fields of the same names in front of it)
# the transport's own words differ per platform (a different HTTP client on Windows); ours do not
query III
SELECT s LIKE '%"queue_fill"%"export_errors":0%', s LIKE '%"queue_fill"%"last_error":null%',
       s LIKE '%"last_error":"the export failed (otlp/http -> http://127.0.0.1:1/v1/logs)%'
FROM (SELECT acl_otel_status() AS s);
----
false	false	true

# spec 005: sampling thins what the sink stores and never what the node counts. An allowed
# statement needs something to read, so the analyst gets a table first.
statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, tenant VARCHAR);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders;

statement ok
SET GLOBAL acl_audit_level = 'all';

statement ok
SET GLOBAL acl_otel_sample_allowed = '0';

statement ok
ACL ROLE 'analyst' SELECT count(*) FROM orders;

statement ok
ACL ROLE 'analyst' SELECT count(*) FROM orders;

statement ok
SELECT acl_audit_flush();

query I
SELECT acl_otel_status() LIKE '%"sampled":0%';
----
false

# the base counted every one of them whatever we sampled away
query I
SELECT value > 0 FROM acl_metrics() WHERE name = 'acl.decisions' LIMIT 1;
----
true

statement ok
SET GLOBAL acl_otel_sample_allowed = '1';

# spec 008: a statement the caller traced is a span candidate; under `linked` one without a parent
# is not. The transport's failure is the records' (the same closed port), counted on the lane.
statement ok
SET GLOBAL acl_otel_traces = 'linked';

statement ok
ACL ROLE 'analyst' TRACE 'req-1' PARENT '00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01' SELECT count(*) FROM orders;

statement ok
ACL ROLE 'analyst' SELECT count(*) FROM orders;

statement ok
SELECT acl_audit_flush();

query I
SELECT acl_otel_traces_flush();
----
true

query II
SELECT s LIKE '%"traces":{"mode":"linked"%"received":1,%',
       s LIKE '%"traces":{%"last_error":"the export failed (otlp/http -> http://127.0.0.1:1/v1/traces)%'
FROM (SELECT acl_otel_status() AS s);
----
true	true

statement ok
SET GLOBAL acl_otel_traces = 'off';

# the flush answers false once the sink is gone
statement ok
SELECT acl_otel_stop();

query I
SELECT acl_otel_flush();
----
false
