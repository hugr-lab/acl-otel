# name: test/sql/acl_otel_lineage.test
# description: spec 018 - the OpenLineage lane's settings: off by default, built at the SET, global only; the key never a setting (its secret type redacts it); flush answers
# group: [sql]

statement ok
LOAD '{BUILD_DIRECTORY}/extension/acl_otel/acl_otel.duckdb_extension';

# off by default: no lane, and the sink does not ask the base for lineage
query I
SELECT acl_otel_status() LIKE '%"lineage":null%';
----
true

query I
SELECT acl_otel_lineage_flush();
----
false

# a backend named: the lane is built at once, its URL joined to the endpoint and shown without userinfo
statement ok
SET GLOBAL acl_otel_lineage_bootstrap = false;

# a credential is never part of the URL: refused at the SET
statement error
SET GLOBAL acl_otel_lineage = 'http://user:pass@127.0.0.1:9/';
----
<REGEX>:.*never part of a URL.*

query I
SELECT acl_otel_status() LIKE '%"lineage":null%';
----
true

statement ok
SET GLOBAL acl_otel_lineage = 'http://127.0.0.1:9/';

query II
SELECT s LIKE '%"lineage":{"url":"http://127.0.0.1:9/api/v1/lineage"%', s LIKE '%"key":""%'
FROM (SELECT acl_otel_status() AS s);
----
true	true

# nothing queued: a flush answers at once
query I
SELECT acl_otel_lineage_flush();
----
true

statement ok
SET GLOBAL acl_otel_lineage_endpoint = 'openapi/openlineage/api/v1/lineage';

query I
SELECT acl_otel_status() LIKE '%"url":"http://127.0.0.1:9/openapi/openlineage/api/v1/lineage"%';
----
true

# global only
statement error
SET acl_otel_lineage = 'http://x';
----
<REGEX>:.*acl_otel_lineage.*global.*

# the key is a secret's, never a setting's: the secret type is ours, and its api_key is redacted
statement ok
CREATE SECRET ol_key (TYPE openlineage, API_KEY 'k-123');

query I
SELECT secret_string LIKE '%api_key=redacted%' FROM duckdb_secrets() WHERE name = 'ol_key';
----
true

# stopped and started again: the lane comes back from the settings
query II
SELECT acl_otel_stop(), acl_otel_start();
----
true	true

query I
SELECT acl_otel_status() LIKE '%"lineage":{"url"%';
----
true

# switched off: the lane goes
statement ok
SET GLOBAL acl_otel_lineage = '';

query I
SELECT acl_otel_status() LIKE '%"lineage":null%';
----
true
